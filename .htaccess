Options All -Indexes
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Bloquea el acceso directo a archivos .php en las carpetas "controladores" y "modelos"
RewriteRule ^src/(controladores|modelos)/.*\.php$ - [F,L]

# Redirige todo excepto archivos y carpetas existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Reescribe la URL para que todo pase por index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Redirige errores 403 a la página de error 404
ErrorDocument 403 /Sistema-del--CEM--JEHOVA-RAFA/404.php


# CABECERAS DE SEGURIDAD HTTP

# Prevenir Clickjacking (que tu sitio sea embebido en iframes)
Header always set X-Frame-Options "DENY"

# Prevenir MIME-sniffing (que el navegador interprete archivos como otro tipo)
Header always set X-Content-Type-Options "nosniff"

# Protección contra XSS en navegadores antiguos
Header always set X-XSS-Protection "1; mode=block"

# Controlar la información que se envía en el header Referer
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Deshabilitar la detección de tipo MIME para recursos descargados
Header always set X-Download-Options "noopen"

# Política básica de seguridad de contenido
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self';"